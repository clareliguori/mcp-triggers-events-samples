{
  "name": "mcp-events-serverless-agent",
  "version": "0.0.1",
  "private": true,
  "description": "MCP Events Serverless Agent — earthquake monitoring sample (multi-package monorepo)",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/shared",
    "packages/cdk",
    "packages/data-api",
    "packages/usgs-server",
    "packages/scheduler-server",
    "packages/webhook-receiver",
    "packages/agent",
    "packages/subscription-manager",
    "packages/webapp"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws/run-mcp-servers-with-aws-lambda": "0.5.19",
    "@deliveryhero/dynamodb-lock": "2.0.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@strands-agents/sdk": "1.3.0",
    "aws-cdk-lib": "2.230.0",
    "constructs": "10.4.2",
    "standardwebhooks": "1.0.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.10.10",
    "fast-check": "3.23.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
